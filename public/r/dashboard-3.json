{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-3",
  "type": "registry:block",
  "title": "Call Analytics Dashboard",
  "description": "Voice operations analytics with interactive filters, call volume trends, agent rankings, and integration health.",
  "dependencies": [
    "lucide-react",
    "recharts"
  ],
  "registryDependencies": [
    "tyrailleverett/nice-ui/style",
    "badge",
    "button",
    "card",
    "chart",
    "progress",
    "select"
  ],
  "files": [
    {
      "path": "registry/app/dashboard-3/dashboard-3.tsx",
      "type": "registry:component",
      "target": "~/components/app/dashboard-3.tsx",
      "content": "import {\n  ArrowRightIcon,\n  BotIcon,\n  CalendarDaysIcon,\n  ExternalLinkIcon,\n  HeadphonesIcon,\n  MessageSquareIcon,\n  PlusIcon,\n  Settings2Icon,\n  VideoIcon,\n} from \"lucide-react\";\nimport { Area, AreaChart, CartesianGrid, XAxis, YAxis } from \"recharts\";\n\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardAction,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport {\n  type ChartConfig,\n  ChartContainer,\n  ChartTooltip,\n  ChartTooltipContent,\n} from \"@/components/ui/chart\";\nimport {\n  Select,\n  SelectContent,\n  SelectGroup,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { cn } from \"@/lib/utils\";\n\nconst callData = [\n  { calls: 73_200, date: \"17 Aug\" },\n  { calls: 75_400, date: \"18 Aug\" },\n  { calls: 74_100, date: \"19 Aug\" },\n  { calls: 78_300, date: \"20 Aug\" },\n  { calls: 76_900, date: \"21 Aug\" },\n  { calls: 81_200, date: \"22 Aug\" },\n  { calls: 79_300, date: \"23 Aug\" },\n  { calls: 77_900, date: \"24 Aug\" },\n] as const;\n\nconst callConfig = {\n  calls: { color: \"var(--chart-2)\", label: \"Calls\" },\n} satisfies ChartConfig;\n\nconst agentData = [\n  { calls: \"6,424\", name: \"Docs Support Agent\", value: 100 },\n  { calls: \"3,942\", name: \"Website Agent\", value: 61 },\n  { calls: \"1,820\", name: \"Billing Triage Agent\", value: 38 },\n  { calls: \"1,194\", name: \"Acme Co.\", value: 29 },\n  { calls: \"1,094\", name: \"Store Assistant\", value: 26 },\n] as const;\n\nconst integrations = [\n  {\n    detail: \"Transcripts and response traces\",\n    icon: BotIcon,\n    name: \"OpenAI\",\n    state: \"Live\",\n  },\n  {\n    detail: \"Escalation alerts and handoffs\",\n    icon: MessageSquareIcon,\n    name: \"Slack\",\n    state: \"Live\",\n  },\n  {\n    detail: \"SIP routing and failover\",\n    icon: HeadphonesIcon,\n    name: \"Voice Gateway\",\n    state: \"Live\",\n  },\n  {\n    detail: \"Scheduled call recordings\",\n    icon: VideoIcon,\n    name: \"Google Meet\",\n    state: \"Review\",\n  },\n] as const;\n\nexport interface Dashboard3Props {\n  className?: string;\n}\n\nexport function Dashboard3({ className }: Dashboard3Props) {\n  return (\n    <main\n      className={cn(\n        \"min-h-screen bg-background p-4 text-foreground sm:p-6 lg:p-8\",\n        className\n      )}\n    >\n      <div className=\"mx-auto flex max-w-[1280px] flex-col gap-4\">\n        <header className=\"flex flex-col gap-4\">\n          <div className=\"flex flex-col justify-between gap-3 sm:flex-row sm:items-center\">\n            <div className=\"flex items-center gap-3\">\n              <h1 className=\"font-semibold text-2xl\">Overview</h1>\n              <span className=\"flex items-center gap-1 text-muted-foreground text-sm\">\n                <HeadphonesIcon className=\"size-4 text-chart-2\" />\n                Active Calls <strong className=\"text-foreground\">294</strong>\n              </span>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <Button>\n                <PlusIcon data-icon=\"inline-start\" />\n                Add\n              </Button>\n              <Button variant=\"outline\">\n                <Settings2Icon data-icon=\"inline-start\" />\n                Configure\n              </Button>\n            </div>\n          </div>\n          <div className=\"grid gap-2 sm:grid-cols-2 lg:grid-cols-[180px_180px_180px_auto]\">\n            <Select\n              defaultValue=\"7-days\"\n              items={[\n                { label: \"Last 7 days\", value: \"7-days\" },\n                { label: \"Last 30 days\", value: \"30-days\" },\n              ]}\n            >\n              <SelectTrigger aria-label=\"Date range\">\n                <CalendarDaysIcon />\n                <SelectValue />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectGroup>\n                  <SelectItem value=\"7-days\">Last 7 days</SelectItem>\n                  <SelectItem value=\"30-days\">Last 30 days</SelectItem>\n                </SelectGroup>\n              </SelectContent>\n            </Select>\n            <Select\n              defaultValue=\"daily\"\n              items={[\n                { label: \"Daily\", value: \"daily\" },\n                { label: \"Weekly\", value: \"weekly\" },\n              ]}\n            >\n              <SelectTrigger aria-label=\"Cadence\">\n                <SelectValue />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectGroup>\n                  <SelectItem value=\"daily\">Daily</SelectItem>\n                  <SelectItem value=\"weekly\">Weekly</SelectItem>\n                </SelectGroup>\n              </SelectContent>\n            </Select>\n            <Select\n              defaultValue=\"all\"\n              items={[\n                { label: \"All agents\", value: \"all\" },\n                { label: \"Support agents\", value: \"support\" },\n              ]}\n            >\n              <SelectTrigger aria-label=\"Agent group\">\n                <SelectValue />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectGroup>\n                  <SelectItem value=\"all\">All agents</SelectItem>\n                  <SelectItem value=\"support\">Support agents</SelectItem>\n                </SelectGroup>\n              </SelectContent>\n            </Select>\n            <Button className=\"justify-self-start\" variant=\"outline\">\n              <PlusIcon data-icon=\"inline-start\" />\n              Add Filter\n            </Button>\n          </div>\n        </header>\n\n        <Card className=\"py-0\">\n          <CardHeader className=\"grid grid-cols-2 gap-0 border-b p-0 md:grid-cols-3 xl:grid-cols-6\">\n            {[\n              [\"Calls\", \"77,258\"],\n              [\"Avg. duration\", \"2:51\"],\n              [\"Total cost\", \"33,402 credits\"],\n              [\"Avg. cost per call\", \"0.43 credits\"],\n              [\"Total LLM cost\", \"$7,258\"],\n              [\"Avg. LLM cost\", \"$0.09\"],\n            ].map(([label, value], index) => (\n              <Button\n                className=\"h-auto min-h-20 flex-col items-start justify-center gap-1 rounded-none border-r px-4\"\n                key={label}\n                type=\"button\"\n                variant=\"ghost\"\n              >\n                <span className=\"text-muted-foreground text-sm\">{label}</span>\n                <strong>{value}</strong>\n                {index === 0 ? (\n                  <span className=\"mt-auto h-0.5 w-full bg-primary\" />\n                ) : null}\n              </Button>\n            ))}\n          </CardHeader>\n          <CardContent className=\"p-4 sm:p-6\">\n            <div className=\"mb-2 text-right text-muted-foreground text-sm\">\n              Min <strong className=\"text-foreground\">71,800</strong>{\" \"}\n              &nbsp;•&nbsp; Max{\" \"}\n              <strong className=\"text-foreground\">82,300</strong>\n            </div>\n            <ChartContainer className=\"h-[420px] w-full\" config={callConfig}>\n              <AreaChart\n                accessibilityLayer\n                data={callData}\n                margin={{ left: 12, right: 12, top: 12 }}\n              >\n                <CartesianGrid vertical={false} />\n                <XAxis\n                  axisLine={false}\n                  dataKey=\"date\"\n                  tickLine={false}\n                  tickMargin={12}\n                />\n                <YAxis domain={[70_000, 84_000]} hide />\n                <ChartTooltip\n                  content={<ChartTooltipContent />}\n                  cursor={false}\n                />\n                <Area\n                  dataKey=\"calls\"\n                  fill=\"var(--color-calls)\"\n                  fillOpacity={0.12}\n                  stroke=\"var(--color-calls)\"\n                  strokeWidth={2}\n                  type=\"natural\"\n                />\n              </AreaChart>\n            </ChartContainer>\n            <div className=\"mt-2 flex justify-end\">\n              <Button variant=\"outline\">\n                View more\n                <ArrowRightIcon data-icon=\"inline-end\" />\n              </Button>\n            </div>\n          </CardContent>\n        </Card>\n\n        <section className=\"grid gap-4 xl:grid-cols-2\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Most Called Agents</CardTitle>\n              <CardDescription>Call volume by agent</CardDescription>\n              <CardAction>\n                <Select\n                  defaultValue=\"calls\"\n                  items={[\n                    { label: \"Calls\", value: \"calls\" },\n                    { label: \"Cost\", value: \"cost\" },\n                  ]}\n                >\n                  <SelectTrigger aria-label=\"Metric\" className=\"w-32\">\n                    <SelectValue />\n                  </SelectTrigger>\n                  <SelectContent>\n                    <SelectGroup>\n                      <SelectItem value=\"calls\">Calls</SelectItem>\n                      <SelectItem value=\"cost\">Cost</SelectItem>\n                    </SelectGroup>\n                  </SelectContent>\n                </Select>\n              </CardAction>\n            </CardHeader>\n            <CardContent className=\"flex flex-col gap-3\">\n              {agentData.map((agent, index) => (\n                <div\n                  className=\"grid grid-cols-[1fr_auto] items-center gap-4\"\n                  key={agent.name}\n                >\n                  <div className=\"relative overflow-hidden rounded-full bg-muted px-4 py-2\">\n                    <span\n                      className=\"absolute inset-y-0 left-0 bg-chart-2/25\"\n                      style={{ width: `${agent.value}%` }}\n                    />\n                    <span className=\"relative flex items-center gap-2 font-medium text-sm\">\n                      <span className=\"size-2 rounded-full bg-chart-2\" />\n                      {agent.name}\n                    </span>\n                  </div>\n                  <strong\n                    className={index === 0 ? \"text-chart-2\" : \"text-foreground\"}\n                  >\n                    {agent.calls}\n                  </strong>\n                </div>\n              ))}\n            </CardContent>\n          </Card>\n\n          <Card>\n            <CardHeader>\n              <CardTitle>Integrations</CardTitle>\n              <CardDescription>Connections for voice ops</CardDescription>\n              <CardAction>\n                <Button size=\"sm\" variant=\"outline\">\n                  Manage\n                  <ExternalLinkIcon data-icon=\"inline-end\" />\n                </Button>\n              </CardAction>\n            </CardHeader>\n            <CardContent className=\"flex flex-col\">\n              {integrations.map(({ icon: Icon, name, detail, state }) => (\n                <div\n                  className=\"flex items-center gap-3 border-b py-3 first:pt-0 last:border-0 last:pb-0\"\n                  key={name}\n                >\n                  <span className=\"grid size-9 place-items-center rounded-lg bg-muted\">\n                    <Icon className=\"size-5\" />\n                  </span>\n                  <div className=\"min-w-0 flex-1\">\n                    <p className=\"font-medium\">{name}</p>\n                    <p className=\"truncate text-muted-foreground text-sm\">\n                      {detail}\n                    </p>\n                  </div>\n                  <Badge variant={state === \"Live\" ? \"secondary\" : \"outline\"}>\n                    {state}\n                  </Badge>\n                  <Button size=\"sm\" variant=\"outline\">\n                    Connect\n                  </Button>\n                </div>\n              ))}\n            </CardContent>\n          </Card>\n        </section>\n      </div>\n    </main>\n  );\n}\n"
    }
  ]
}
