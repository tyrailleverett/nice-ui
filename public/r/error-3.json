{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "error-3",
  "type": "registry:block",
  "title": "Interrupted Page",
  "description": "500-style failed record load with a request ID, retry, and ghosted inspector layout.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "tyrailleverett/nice-ui/style",
    "button",
    "empty",
    "skeleton"
  ],
  "files": [
    {
      "path": "registry/app/error/error-3/error-3.tsx",
      "type": "registry:component",
      "target": "~/components/app/error-3.tsx",
      "content": "import { CopyIcon, RotateCcwIcon } from \"lucide-react\";\n\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Empty,\n  EmptyContent,\n  EmptyDescription,\n  EmptyHeader,\n  EmptyTitle,\n} from \"@/components/ui/empty\";\nimport { Skeleton } from \"@/components/ui/skeleton\";\nimport { cn } from \"@/lib/utils\";\n\nexport interface Error3Props {\n  className?: string;\n  onCopyRequestId?: () => void;\n  onRetry?: () => void;\n  requestId?: string;\n}\n\nexport function Error3({\n  className,\n  onCopyRequestId,\n  onRetry,\n  requestId = \"FUL-8F2C-19\",\n}: Error3Props) {\n  return (\n    <main\n      className={cn(\n        \"min-h-screen bg-background p-4 text-foreground sm:p-6 lg:p-8\",\n        className\n      )}\n    >\n      <div className=\"mx-auto flex max-w-[1100px] flex-col gap-5\">\n        <div className=\"flex flex-col gap-2\">\n          <Skeleton className=\"h-4 w-48\" />\n          <Skeleton className=\"h-8 w-56\" />\n        </div>\n\n        <Empty className=\"border border-dashed\">\n          <EmptyHeader className=\"max-w-lg\">\n            <EmptyTitle className=\"text-xl\">\n              Packing state did not load\n            </EmptyTitle>\n            <EmptyDescription>\n              The fulfillment service stopped while reading NSC-84763. The queue\n              is still up; this record is not.\n            </EmptyDescription>\n          </EmptyHeader>\n          <EmptyContent className=\"max-w-md\">\n            <p className=\"font-mono text-muted-foreground text-xs\">\n              Request {requestId}\n            </p>\n            <div className=\"flex flex-wrap justify-center gap-2\">\n              <Button onClick={onRetry} type=\"button\">\n                <RotateCcwIcon data-icon=\"inline-start\" />\n                Retry\n              </Button>\n              <Button onClick={onCopyRequestId} type=\"button\" variant=\"outline\">\n                <CopyIcon data-icon=\"inline-start\" />\n                Copy request ID\n              </Button>\n            </div>\n          </EmptyContent>\n        </Empty>\n\n        <div\n          aria-hidden=\"true\"\n          className=\"grid gap-4 xl:grid-cols-[minmax(0,1.6fr)_minmax(20rem,0.9fr)]\"\n        >\n          <div className=\"flex flex-col gap-3 rounded-xl border border-border p-4\">\n            <Skeleton className=\"h-5 w-24\" />\n            <Skeleton className=\"h-3 w-full\" />\n            <Skeleton className=\"h-3 w-4/5\" />\n            <Skeleton className=\"h-24 w-full\" />\n          </div>\n          <div className=\"flex flex-col gap-3 rounded-xl border border-border p-4\">\n            <Skeleton className=\"h-5 w-20\" />\n            <Skeleton className=\"h-16 w-full\" />\n            <Skeleton className=\"h-16 w-full\" />\n          </div>\n        </div>\n      </div>\n    </main>\n  );\n}\n"
    }
  ]
}
