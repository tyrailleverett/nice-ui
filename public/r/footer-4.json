      "path": "registry/marketing/footer-4/footer-4.tsx",
      "content": "import type { ComponentProps, ReactNode } from \"react\";\nimport { MarketingSection } from \"@/components/marketing-section\";\nimport { Button } from \"@/components/ui/button\";\nimport { AppStoreBadge } from \"./app-store-badge\";\nimport { GooglePlayBadge } from \"./google-play-badge\";\n\nexport function FacebookIcon(props: ComponentProps<\"svg\">) {\n  return (\n    <svg aria-hidden=\"true\" fill=\"currentColor\" viewBox=\"0 0 24 24\" {...props}>\n      <title>Facebook</title>\n      <path d=\"M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z\" />\n    </svg>\n  );\n}\n\nexport function InstagramIcon(props: ComponentProps<\"svg\">) {\n  return (\n    <svg aria-hidden=\"true\" fill=\"currentColor\" viewBox=\"0 0 24 24\" {...props}>\n      <title>Instagram</title>\n      <path d=\"M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z\" />\n    </svg>\n  );\n}\n\nexport function LinkedinIcon(props: ComponentProps<\"svg\">) {\n  return (\n    <svg aria-hidden=\"true\" {...props}>\n      <image\n        height=\"100%\"\n        href=\"https://svgl.app/library/linkedin.svg\"\n        width=\"100%\"\n      />\n    </svg>\n  );\n}\n\nexport function XIcon(props: ComponentProps<\"svg\">) {\n  return (\n    <svg aria-hidden=\"true\" {...props}>\n      <image height=\"100%\" href=\"https://svgl.app/library/x.svg\" width=\"100%\" />\n    </svg>\n  );\n}\n\nexport interface Footer4Link {\n  href: string;\n  label: string;\n}\n\nexport interface Footer4LinkGroup {\n  links: Footer4Link[];\n  title: string;\n}\n\nexport interface Footer4SocialLink {\n  href: string;\n  icon: ReactNode;\n  label: string;\n}\n\nexport interface Footer4Props {\n  appStoreHref?: string;\n  className?: string;\n  copyright?: string;\n  googlePlayHref?: string;\n  groups: Footer4LinkGroup[];\n  socialLinks?: Footer4SocialLink[];\n}\n\nexport function Footer4({\n  groups,\n  socialLinks,\n  appStoreHref = \"#\",\n  googlePlayHref = \"#\",\n  copyright = \"Nice UI, All rights reserved\",\n  className,\n}: Footer4Props) {\n  return (\n    <MarketingSection as=\"footer\" className={className}>\n      <div className=\"px-4 lg:px-6\">\n        <div className=\"grid grid-cols-2 gap-8 py-8 md:grid-cols-4\">\n          {groups.map((item) => (\n            <div key={item.title}>\n              <h3 className=\"mb-4 text-xs\">{item.title}</h3>\n              <ul className=\"space-y-2 text-muted-foreground text-sm\">\n                {item.links.map((link) => (\n                  <li key={link.label}>\n                    <a className=\"hover:text-foreground\" href={link.href}>\n                      {link.label}\n                    </a>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n        <div className=\"h-px bg-border\" />\n        <div className=\"flex flex-wrap items-center justify-between gap-4 py-5\">\n          {socialLinks?.length ? (\n            <div className=\"flex items-center gap-2\">\n              {socialLinks.map(({ icon, href, label }) => (\n                <Button\n                  key={label}\n                  nativeButton={false}\n                  render={<a aria-label={label} href={href} />}\n                  size=\"icon\"\n                  variant=\"outline\"\n                >\n                  {icon}\n                </Button>\n              ))}\n            </div>\n          ) : (\n            <div />\n          )}\n\n          <div className=\"flex items-center gap-3\">\n            <GooglePlayBadge href={googlePlayHref} />\n            <AppStoreBadge href={appStoreHref} />\n          </div>\n        </div>\n        <div className=\"h-px bg-border\" />\n        <div className=\"py-4 text-center text-muted-foreground text-xs\">\n          <p>\n            &copy; {new Date().getFullYear()} {copyright}\n          </p>\n        </div>\n      </div>\n    </MarketingSection>\n  );\n}\n",
      "type": "registry:component",
      "target": "~/components/marketing/footer-4.tsx"
    },
