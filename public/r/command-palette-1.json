{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "command-palette-1",
  "type": "registry:block",
  "title": "Quick Actions Command Palette",
  "description": "Grouped quick actions opened from a lightweight button trigger.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "tyrailleverett/nice-ui/style",
    "button",
    "command",
    "dialog"
  ],
  "files": [
    {
      "path": "registry/app/command-palette-1/command-palette-1.tsx",
      "type": "registry:component",
      "target": "~/components/app/command-palette-1.tsx",
      "content": "\"use client\";\n\nimport {\n  FileTextIcon,\n  HouseIcon,\n  InboxIcon,\n  LogOutIcon,\n  MoonIcon,\n  PlusIcon,\n  UserPlusIcon,\n} from \"lucide-react\";\nimport { useCallback, useState } from \"react\";\n\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Command,\n  CommandDialog,\n  CommandEmpty,\n  CommandGroup,\n  CommandInput,\n  CommandItem,\n  CommandList,\n  CommandSeparator,\n  CommandShortcut,\n} from \"@/components/ui/command\";\n\nfunction CommandPalette1() {\n  const [open, setOpen] = useState(false);\n  const openPalette = useCallback(() => {\n    setOpen(true);\n  }, []);\n  return (\n    <>\n      <Button onClick={openPalette} variant=\"outline\">\n        Quick Actions\n      </Button>\n      <CommandDialog onOpenChange={setOpen} open={open}>\n        <Command className=\"**:data-[selected=true]:bg-muted **:data-selected:bg-transparent\">\n          <CommandInput placeholder=\"What do you need?\" />\n          <CommandList>\n            <CommandEmpty>No actions found.</CommandEmpty>\n            <CommandGroup heading=\"Create\">\n              <CommandItem>\n                <PlusIcon />\n                <span>New Project</span>\n                <CommandShortcut>⌘N</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <FileTextIcon />\n                <span>New Document</span>\n                <CommandShortcut>⌘⇧N</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <UserPlusIcon />\n                <span>Invite Member</span>\n                <CommandShortcut>⌘I</CommandShortcut>\n              </CommandItem>\n            </CommandGroup>\n            <CommandSeparator />\n            <CommandGroup heading=\"Navigate\">\n              <CommandItem>\n                <HouseIcon />\n                <span>Go to Dashboard</span>\n                <CommandShortcut>⌘D</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <InboxIcon />\n                <span>Go to Inbox</span>\n                <CommandShortcut>⌘⇧I</CommandShortcut>\n              </CommandItem>\n            </CommandGroup>\n            <CommandSeparator />\n            <CommandGroup heading=\"System\">\n              <CommandItem>\n                <MoonIcon />\n                <span>Toggle Dark Mode</span>\n                <CommandShortcut>⌘⇧D</CommandShortcut>\n              </CommandItem>\n              <CommandItem>\n                <LogOutIcon />\n                <span>Sign Out</span>\n                <CommandShortcut>⌘Q</CommandShortcut>\n              </CommandItem>\n            </CommandGroup>\n          </CommandList>\n        </Command>\n      </CommandDialog>\n    </>\n  );\n}\n\nexport default CommandPalette1;\n"
    }
  ]
}
