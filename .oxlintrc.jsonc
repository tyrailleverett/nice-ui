{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "jsx-a11y",
    "react-perf",
    "promise",
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
  },
  "env": {
    "browser": true,
    "node": true,
    "builtin": true,
  },
  "settings": {
    "react": {
      "version": "19.2",
    },
  },
  "ignorePatterns": [
    "src/components/ui/**",
    "public/**",
    "dist/**",
    "storybook-static/**",
    "build/**",
    "public/r/**",
    "registry/marketing/screenshot-assets/*.svg",
  ],
  "rules": {
    // React 19 uses the automatic JSX runtime; `React` is not required in scope.
    "react/react-in-jsx-scope": "off",
  },
}
