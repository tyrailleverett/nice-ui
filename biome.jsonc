{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": [
      "!src/components/ui",
      "!public",
      "!registry/marketing/screenshot-assets/*.svg"
    ]
  },
  "overrides": [
    {
      "includes": ["src/components/**", "src/hooks/**"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ]
}
