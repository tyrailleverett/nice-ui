{
  "name": "nice-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && rsbuild build",
    "build:storybook": "storybook build",
    "check": "oxfmt --check && oxlint",
    "dev": "storybook dev -p 6006",
    "fix": "oxfmt --write && oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "lefthook install",
    "preview": "rsbuild preview",
    "preview:storybook": "bun scripts/preview-storybook.ts",
    "registry:build": "bun scripts/build-registry.ts",
    "registry:validate": "bunx shadcn@latest registry validate ./registry.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.4",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@rsbuild/core": "^2.2.6",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-themes": "10.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "lefthook": "^2.1.10",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "storybook": "10.6.0",
    "storybook-react-rsbuild": "^3.4.2",
    "typescript": "^7.0.2"
  }
}
